<mvc:View
    controllerName="stk.starterkit.controller.EmployeesList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"

>
    <Page id="EmployeesList"
        title="EmployeesList"
        showNavButton="true"
        navButtonPress=".onNavBack"
    >
        <content>
            <Table
                id="employeesTable"
                class="stripedTable"
                items="{employees>/rows}"
            >
                <columns>
                    <Column id="_IDGenColumn5">
                        <Text id="_IDGenText9" text="Name" />
                    </Column>

                    <Column id="_IDGenColumn6">
                        <Text id="_IDGenText10" text="Position" />
                    </Column>

                    <Column id="_IDGenColumn7">
                        <Text id="_IDGenText11" text="Orders" />
                    </Column>

                    <Column id="_IDGenColumn8" hAlign="End">
                        <Text id="_IDGenText12" text="Actions" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem id="_IDGenColumnListItem2">
                        <cells>
                            <Text id="_IDGenText13"
                                text="{employees>FirstName} {employees>LastName}"
                            />

                            <Text id="_IDGenText14" text="{employees>Title}" />

                            <Text id="_IDGenText15" text="{employees>OrderCount}" />

                            <HBox id="_IDGenHBox" justifyContent="End">
                                <Button id="_IDGenButton2"
                                    text="Motivate"
                                    press=".onMotivate"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button id="_IDGenButton3"
                                    text="Fire"
                                    press=".onFire"
                                />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>